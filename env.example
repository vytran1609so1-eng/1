# ---------------------------------------------------------------------------
#  Copy this file to .env.local (for local development) and paste the same
#  values into Vercel → Settings → Environment Variables when deploying.
#  Never commit .env.local, and never paste the secret key into a chat or email.
#
#  The site runs fine without these — only /admin and the guestbook need them.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → the SECRET key (starts with sb_secret_).
# This is the modern replacement for the old service_role key. SERVER ONLY —
# never put it in a NEXT_PUBLIC_ variable. The name SUPABASE_SECRET_KEY also works.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# The password you choose for /admin and /guestbook/admin
ADMIN_PASSWORD=
